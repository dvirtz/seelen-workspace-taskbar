{
  "branches": ["main", { "name": "beta", "prerelease": true }],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "semantic-release-mirror-version",
      {
        "fileGlob": "{package.json,package-lock.json}",
        "placeholderRegExp": "(?<=\"name\": \"@dvirtz/seelen-workspace-taskbar\",\\s*\"version\": \")[^\"]+"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/bundles/*.yml",
            "name": "workspace-taskbar-${nextRelease.version}.yml",
            "label": "Seelen Workspace Taskbar bundle"
          }
        ]
      }
    ]
  ]
}
